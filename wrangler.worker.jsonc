{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siteproxy", // worker name
  "main": "build/worker.js",
  "compatibility_date": "2025-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "siteproxy.520215.xyz", "custom_domain": true }
  ],
  "vars": {
    "proxy_url": "https://siteproxy.520215.xyz",
    "token_prefix": "/Kp7m2Xq9/" // access password, keep leading/trailing slashes
  }
}
